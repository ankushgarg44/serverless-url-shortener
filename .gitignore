# Terraform working data and local state
**/.terraform/*
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/*.tfvars
**/*.tfvars.json
**/crash.log
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json

# Keep the dependency lock file in version control.
!**/.terraform.lock.hcl

# Generated Lambda deployment archives
lambda/*.zip

# Python caches
**/__pycache__/
**/*.py[cod]
.venv/
.pytest_cache/

# macOS
.DS_Store

# Local secrets and generated repository bundles
.env
.env.*
!.env.example
repomix-output.*
